{
  "name": "ctxjev-mcp",
  "version": "0.7.2",
  "description": "MCP server exposing ctxjev's context scoring/pruning as tools for any MCP-capable agent host: offline (scorer local or recency) or with Jev.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "llm",
    "context-pruning",
    "jev",
    "claude-code",
    "codex"
  ],
  "license": "MIT",
  "author": {
    "name": "Re:COO",
    "url": "https://github.com/x96x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x96x64/ctxjev.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/x96x64/ctxjev/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/x96x64/ctxjev/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "ctxjev-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/readmes.mjs --pack",
    "postpack": "node ../../scripts/readmes.mjs --unpack",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ctxjev-core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
