{
  "name": "ctxjev-core",
  "version": "0.7.2",
  "description": "Decide what to keep, drop, or summarize in AI agent context: by recency (the default), keyword overlap, or Jev's relevance scores (opt-in).",
  "keywords": [
    "ai-agent",
    "llm",
    "context-window",
    "context-pruning",
    "token-optimization",
    "jev",
    "typesafe-ai"
  ],
  "license": "MIT",
  "author": {
    "name": "Re:COO",
    "url": "https://github.com/x96x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x96x64/ctxjev.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/x96x64/ctxjev/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/x96x64/ctxjev/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/readmes.mjs --pack",
    "postpack": "node ../../scripts/readmes.mjs --unpack",
    "test": "vitest run --exclude \"eval/fixtures/**\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "eval": "node eval/run.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "gpt-tokenizer": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
